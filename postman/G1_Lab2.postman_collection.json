{
  "info": {
    "name": "G1_Lab2 · Prisma y transacciones",
    "description": "CRUD con PostgreSQL y comprobaciones COMMIT/ROLLBACK para el Laboratorio 2.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Listar productos",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\",()=>pm.response.to.have.status(200));",
              "pm.test(\"Devuelve un arreglo\",()=>pm.expect(pm.response.json()).to.be.an(\"array\"));",
              "const products = pm.response.json(); pm.test(\"Hay productos de seed\",()=>pm.expect(products.length).to.be.above(0)); pm.collectionVariables.set(\"seedProductId\", products[0].id);"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/products",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "products"
          ]
        }
      }
    },
    {
      "name": "2. Crear producto",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\",()=>pm.response.to.have.status(201));",
              "const x=pm.response.json(); pm.collectionVariables.set(\"createdId\",x.id);",
              "pm.test(\"SKU generado\",()=>pm.expect(x.sku).to.be.a(\"string\"));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/products",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "products"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\"name\":\"Producto Postman Lab 2\",\"institution\":\"Prueba\",\"category\":\"Accesorio\",\"price\":12.5}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "3. Consultar producto de seed (ID dinámico)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\",()=>pm.response.to.have.status(200));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/products/{{seedProductId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "products",
            "{{seedProductId}}"
          ]
        }
      }
    },
    {
      "name": "4. Actualizar producto",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\",()=>pm.response.to.have.status(200));",
              "pm.test(\"Precio actualizado\",()=>pm.expect(pm.response.json().price).to.eql(15));"
            ]
          }
        }
      ],
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/products/{{createdId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "products",
            "{{createdId}}"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\"price\":15}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "5. Crear lote válido (COMMIT)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\",()=>pm.response.to.have.status(201));",
              "pm.test(\"Crea los dos\",()=>pm.expect(pm.response.json()).to.have.lengthOf(2));",
              "pm.collectionVariables.set(\"batchA\",pm.response.json()[0].id);",
              "pm.collectionVariables.set(\"batchB\",pm.response.json()[1].id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/products/lote",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "products",
            "lote"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "[{\"name\":\"Lote Postman A\",\"price\":3.5},{\"name\":\"Lote Postman B\",\"price\":4.5}]",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
