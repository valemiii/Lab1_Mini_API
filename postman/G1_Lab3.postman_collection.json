                "exec": [
                  "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
                  "const r = pm.response.json();",
                  "pm.test(\"Respuesta paginada\", () => { pm.expect(r).to.include.keys(\"page\", \"limit\", \"total\", \"pages\", \"data\"); pm.expect(r.data.length).to.be.at.most(5); });",
