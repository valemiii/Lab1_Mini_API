{
  "info": {
    "_postman_id": "c1aa2c1f-6a78-4e51-9079-c8863a2aa001",
    "name": "Tarjeta A - Reseñas - Valeria Guaiguacundo",
    "description": "Pruebas locales de creación, consulta y eliminación de reseñas, incluidos permisos y errores.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://127.0.0.1:3000" },
    { "key": "authorEmail", "value": "ana@correo.com" },
    { "key": "authorPassword", "value": "Ana12345*" },
    { "key": "adminEmail", "value": "admin@apdaf.com" },
    { "key": "adminPassword", "value": "Admin123*" },
    { "key": "alternatePassword", "value": "Alternate123*" },
    { "key": "productId", "value": "" },
    { "key": "authorToken", "value": "" },
    { "key": "alternateToken", "value": "" },
    { "key": "adminToken", "value": "" },
    { "key": "reviewId", "value": "" },
    { "key": "adminReviewId", "value": "" }
  ],
  "item": [
    {
      "name": "Preparación",
      "item": [
        {
          "name": "Buscar producto de prueba",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/products"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 200 y contiene productos', function () {",
                  "    pm.response.to.have.status(200);",
                  "    const products = pm.response.json();",
                  "    pm.expect(products).to.be.an('array').that.is.not.empty;",
                  "    const product = products.find((entry) => entry.sku === 'APD-CAM-001') || products[0];",
                  "    pm.expect(product.id).to.be.a('number');",
                  "    pm.collectionVariables.set('productId', product.id);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Registrar usuario alterno para permisos",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('alternateEmail', `review-alt-${Date.now()}-${Math.floor(Math.random() * 10000)}@example.com`);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Usuario alterno creado', function () {",
                  "    pm.response.to.have.status(201);",
                  "    pm.expect(pm.response.json().user.name).to.eql('Usuario alterno');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Usuario alterno\",\n  \"email\": \"{{alternateEmail}}\",\n  \"password\": \"{{alternatePassword}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/auth/register"
          }
        },
        {
          "name": "Iniciar sesión como autor",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{authorEmail}}\",\n  \"password\": \"{{authorPassword}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/auth/login"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Autor autenticado', function () {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(pm.response.json().token).to.be.a('string').and.not.empty;",
                  "    pm.collectionVariables.set('authorToken', pm.response.json().token);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Iniciar sesión como usuario alterno",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{alternateEmail}}\",\n  \"password\": \"{{alternatePassword}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/auth/login"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Usuario alterno autenticado', function () {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(pm.response.json().token).to.be.a('string').and.not.empty;",
                  "    pm.collectionVariables.set('alternateToken', pm.response.json().token);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Iniciar sesión como ADMIN",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/auth/login"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('ADMIN autenticado', function () {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(pm.response.json().token).to.be.a('string').and.not.empty;",
                  "    pm.collectionVariables.set('adminToken', pm.response.json().token);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Crear reseñas",
      "item": [
        {
          "name": "201 - Crear reseña",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authorToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"rating\": 4,\n  \"comment\": \"Buena calidad y entrega puntual\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/products/{{productId}}/reviews"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Reseña creada y queda disponible para las siguientes pruebas', function () {",
                  "    pm.response.to.have.status(201);",
                  "    const review = pm.response.json();",
                  "    pm.expect(review.rating).to.eql(4);",
                  "    pm.expect(review.user.name).to.eql('Ana Torres');",
                  "    pm.collectionVariables.set('reviewId', review.id);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "400 - Rating fuera del rango",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authorToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"rating\": 6\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/api/products/{{productId}}/reviews"
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Rating inválido devuelve 400', function () { pm.response.to.have.status(400); pm.expect(pm.response.json().error).to.be.a('string').and.not.empty; });"] } }]
        },
        {
          "name": "401 - Crear sin token",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"rating\": 4\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/api/products/{{productId}}/reviews"
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Se exige autenticación', function () { pm.response.to.have.status(401); pm.expect(pm.response.json().error).to.be.a('string').and.not.empty; });"] } }]
        },
        {
          "name": "404 - Producto inexistente",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authorToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"rating\": 4\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/api/products/999999999/reviews"
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Producto inexistente devuelve 404', function () { pm.response.to.have.status(404); pm.expect(pm.response.json().error).to.be.a('string').and.not.empty; });"] } }]
        },
        {
          "name": "409 - Reseña duplicada",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authorToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"rating\": 3\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/api/products/{{productId}}/reviews"
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('La restricción única devuelve 409', function () { pm.response.to.have.status(409); pm.expect(pm.response.json().error).to.be.a('string').and.not.empty; });"] } }]
        },
        {
          "name": "201 - Crear reseña como ADMIN",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"rating\": 5,\n  \"comment\": \"Reseña de administración\"\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/api/products/{{productId}}/reviews"
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('ADMIN también puede crear una reseña', function () {", "    pm.response.to.have.status(201);", "    const review = pm.response.json();", "    pm.expect(review.rating).to.eql(5);", "    pm.expect(review.user.name).to.eql('Administración APDAF');", "    pm.collectionVariables.set('adminReviewId', review.id);", "});"] } }]
        }
      ]
    },
    {
      "name": "Consultar reseñas",
      "item": [
        {
          "name": "200 - Listar, paginar y obtener promedio",
          "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/api/products/{{productId}}/reviews?page=1&limit=10" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Lista reseñas con promedio y paginación', function () {", "    pm.response.to.have.status(200);", "    const result = pm.response.json();", "    pm.expect(result.productId).to.eql(Number(pm.collectionVariables.get('productId')));", "    pm.expect(result.average).to.be.a('number');", "    pm.expect(result.total).to.be.at.least(2);", "    pm.expect(result.page).to.eql(1);", "    pm.expect(result.limit).to.eql(10);", "    pm.expect(result.pages).to.be.at.least(1);", "    pm.expect(result.data).to.be.an('array').that.is.not.empty;", "    pm.expect(result.data[0].user.name).to.be.a('string');", "});"] } }]
        },
        {
          "name": "400 - Página inválida",
          "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/api/products/{{productId}}/reviews?page=0" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Paginación inválida devuelve 400', function () { pm.response.to.have.status(400); pm.expect(pm.response.json().error).to.be.a('string').and.not.empty; });"] } }]
        },
        {
          "name": "404 - Producto inexistente",
          "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/api/products/999999999/reviews" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Producto inexistente devuelve 404', function () { pm.response.to.have.status(404); pm.expect(pm.response.json().error).to.be.a('string').and.not.empty; });"] } }]
        }
      ]
    },
    {
      "name": "Eliminar reseñas",
      "item": [
        {
          "name": "401 - Eliminar sin token",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/api/reviews/{{reviewId}}"
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Eliminar requiere autenticación', function () { pm.response.to.have.status(401); pm.expect(pm.response.json().error).to.be.a('string').and.not.empty; });"] } }]
        },
        {
          "name": "403 - Otro usuario no puede eliminar",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{alternateToken}}" }],
            "url": "{{baseUrl}}/api/reviews/{{reviewId}}"
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Se rechaza eliminación por otro usuario', function () { pm.response.to.have.status(403); pm.expect(pm.response.json().error).to.be.a('string').and.not.empty; });"] } }]
        },
        {
          "name": "404 - Eliminar reseña inexistente",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{authorToken}}" }],
            "url": "{{baseUrl}}/api/reviews/999999999"
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Reseña inexistente devuelve 404', function () { pm.response.to.have.status(404); pm.expect(pm.response.json().error).to.be.a('string').and.not.empty; });"] } }]
        },
        {
          "name": "204 - Autor elimina su reseña",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{authorToken}}" }],
            "url": "{{baseUrl}}/api/reviews/{{reviewId}}"
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Autor elimina y recibe 204 sin cuerpo', function () { pm.response.to.have.status(204); pm.expect(pm.response.text()).to.eql(''); });"] } }]
        },
        {
          "name": "204 - ADMIN elimina reseña",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": "{{baseUrl}}/api/reviews/{{adminReviewId}}"
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('ADMIN elimina y recibe 204 sin cuerpo', function () { pm.response.to.have.status(204); pm.expect(pm.response.text()).to.eql(''); });"] } }]
        }
      ]
    }
  ]
}
