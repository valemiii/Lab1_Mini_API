// Lab 3 · Relaciones, mapeo y consultas avanzadas · APDAF SPORT
// Grupo: G1 · Emprendimiento: Catálogo de uniformes escolares APDAF SPORT
// Modelo adaptado desde el kit al catálogo de uniformes escolares. Incluye
// reemplaza Customer/Product/Order/OrderItem por TUS entidades con al menos:
//   · una relación 1:1, una 1:N y una N:M (implícita o explícita)
//   · onDelete elegido a propósito (Cascade, Restrict o SetNull) en cada relación
//   · un enum, un Decimal o DateTime y un @@index o @@unique compuesto
// Relaciones: User-Customer 1:1 Cascade; Customer-Order 1:N Restrict;
// Order-Product N:M explícita con OrderItem Cascade/Restrict.

generator client {
  provider = "prisma-client-js"
}

// Prisma 7: la URL ya no va aquí; está en prisma.config.ts
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum OrderStatus {
  PENDING
  DELIVERED
  CANCELLED
}

// Usuario que se autentica con JWT (clases 18–20)
model User {
  id        Int       @id @default(autoincrement())
  email     String    @unique @db.VarChar(120)
  password  String // hash de bcrypt, nunca la clave en texto plano
  name      String    @db.VarChar(100)
  role      Role      @default(USER)
  createdAt DateTime  @default(now()) @map("created_at")
  customer  Customer? // 1:1 → el lado sin FK

  @@map("users")
}

// Entidad del Lab 2, ahora relacionada
model Customer {
  id        Int      @id @default(autoincrement())
  fullName  String   @map("full_name") @db.VarChar(100)
  email     String   @unique @db.VarChar(120)
  phone     String?  @db.VarChar(15)
  createdAt DateTime @default(now()) @map("created_at")

  // 1:1 con User: la FK es única. Si se borra el usuario, se borra su perfil
  userId Int?  @unique @map("user_id")
  user   User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  orders Order[] // 1:N

  @@map("customers")
}

model Product {
  id        Int         @id @default(autoincrement())
  name      String      @unique @db.VarChar(80)
  price     Decimal     @db.Decimal(10, 2)
  stock     Int         @default(0)
  category  String?     @db.VarChar(40)
  institution String?   @db.VarChar(80)
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")
  items     OrderItem[] // N:M con Order a través de OrderItem

  @@index([category])

  @@map("products")
}

// 1:N: un cliente tiene muchos pedidos; un pedido pertenece a un cliente
model Order {
  id         Int         @id @default(autoincrement())
  status     OrderStatus @default(PENDING)
  total      Decimal     @db.Decimal(10, 2)
  createdAt  DateTime    @default(now()) @map("created_at")
  customerId Int         @map("customer_id")
  customer   Customer    @relation(fields: [customerId], references: [id], onDelete: Restrict)
  items      OrderItem[]

  @@index([customerId])
  @@index([status, createdAt])
  @@map("orders")
}

// N:M explícita: la tabla intermedia guarda datos propios (cantidad y precio)
model OrderItem {
  orderId   Int     @map("order_id")
  productId Int     @map("product_id")
  quantity  Int
  unitPrice Decimal @map("unit_price") @db.Decimal(10, 2)
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@id([orderId, productId])
  @@map("order_items")
}
